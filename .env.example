# Pixoo device on your LAN (required to push frames)
PIXOO_IP=192.168.1.50

# Google Directions API — https://console.cloud.google.com/
# Enable the Directions API for your project, then paste the key here.
GOOGLE_MAPS_API_KEY=

# Sensibo — https://home.sensibo.com/me/api
SENSIBO_API_KEY=

# Local dry-run (skip Pixoo push, write PNGs under ./preview)
# PIXELPIXOO_PREVIEW=/preview
# PIXELPIXOO_ONCE=true
PIXELPIXOO_VERBOSE=false

# Config web UI (container listens on 8080; host port via PIXELPIXOO_WEB_PORT)
PIXELPIXOO_WEB_HOST=0.0.0.0
PIXELPIXOO_WEB_PORT=8787

# Pixoo device on your LAN (required to push frames)
PIXOO_IP=192.168.1.50

# Google Directions API — https://console.cloud.google.com/ (enable Directions API)
GOOGLE_MAPS_API_KEY=

# Sensibo — https://home.sensibo.com/me/api
SENSIBO_API_KEY=

# Local Docker dry-run (skip Pixoo push, write PNGs to ./preview)
# PIXELPIXOO_PREVIEW=/preview
# PIXELPIXOO_ONCE=true
PIXELPIXOO_VERBOSE=false

# Config web UI
PIXELPIXOO_WEB_HOST=0.0.0.0
PIXELPIXOO_WEB_PORT=8787
